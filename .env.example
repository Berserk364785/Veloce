# Copy to .env. Uvicorn loads it with --env-file .env.
# Exact public HTTPS origin (no trailing slash), optional locally:
# APP_ORIGIN=https://your-veloce.onrender.com
ANILIBRIA_BASE=https://aniliberty.top
# Own provider-issued keys. Never insert these in frontend code.
KINOPOISK_API_KEY=
KODIK_TOKEN=
# Enable only when permitted to resolve direct streams from this source.
ENABLE_KODIK_STREAMS=false
MAX_ROOMS=500
# MEDIA_CATALOG=/absolute/path/to/media.json
# Browser clients receive ICE configuration. Use short-lived TURN credentials for production.
ICE_SERVERS=[{"urls":"stun:stun.l.google.com:19302"}]
# By default PeerJS uses its public signaling service. To self-host PeerServer:
# PEER_HOST=peer.your-domain.example
# PEER_PORT=443
# PEER_PATH=/peerjs
# PEER_SECURE=true
